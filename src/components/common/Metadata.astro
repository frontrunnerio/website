---
import merge from 'lodash.merge';
import { SEO } from 'astro-seo';

import type { SEOProps } from 'astro-seo';

import { SITE, METADATA } from 'astrowind:config';
import type { MetaData, MetaDataOpenGraph } from '~/types';
import { getCanonical } from '~/utils/permalinks';

import { adaptOpenGraphImages } from '~/utils/images';
import { getLang, getMirrorPath, defaultLang } from '~/i18n/utils';

const lang = getLang(Astro);
const pathname = Astro.url.pathname;
const enPath = getMirrorPath(pathname, 'en');
const dePath = getMirrorPath(pathname, 'de');
const ogLocale = lang === 'de' ? 'de_DE' : 'en_US';

export interface Props extends MetaData {
  dontUseTitleTemplate?: boolean;
}

const {
  title,
  ignoreTitleTemplate = false,
  canonical = String(getCanonical(String(Astro.url.pathname))),
  robots = {},
  description,
  openGraph = {},
  twitter = {},
} = Astro.props;

const mergedOg: MetaDataOpenGraph = merge(
  {
    url: canonical,
    siteName: SITE?.name,
    images: [],
    locale: ogLocale,
    type: 'website',
  },
  METADATA?.openGraph,
  { url: canonical, ...openGraph }
);

const adaptedOg = await adaptOpenGraphImages(mergedOg, Astro.site);

const firstImage = adaptedOg?.images?.find((image) => image?.url);

const resolvedTitle = title || METADATA?.title?.default || '';
const resolvedDescription = description || METADATA?.description;

function buildOpenGraph(og: MetaDataOpenGraph): SEOProps['openGraph'] | undefined {
  const imageUrl = firstImage?.url;
  if (!og || !imageUrl) return undefined;

  return {
    basic: {
      title: resolvedTitle,
      type: og.type || 'website',
      image: imageUrl,
      url: og.url,
    },
    optional: {
      description: resolvedDescription,
      locale: og.locale,
      siteName: og.siteName,
    },
    image: {
      url: imageUrl,
      width: firstImage?.width,
      height: firstImage?.height,
      alt: resolvedTitle,
    },
  };
}

type TwitterCard = 'summary_large_image' | 'summary' | undefined;

const mergedTwitter = merge(
  {
    card: (firstImage ? 'summary_large_image' : 'summary') as TwitterCard,
  },
  METADATA?.twitter
    ? {
        card: METADATA.twitter.cardType as TwitterCard,
        site: METADATA.twitter.site,
        creator: METADATA.twitter.handle,
      }
    : {},
  twitter
    ? {
        card: twitter.cardType as TwitterCard,
        site: twitter.site,
        creator: twitter.handle,
      }
    : {}
);

const seoProps: SEOProps = {
  title: resolvedTitle,
  titleTemplate: ignoreTitleTemplate ? '%s' : METADATA?.title?.template || '%s',
  canonical: canonical,
  noindex:
    typeof robots?.index !== 'undefined'
      ? !robots.index
      : typeof METADATA?.robots?.index !== 'undefined'
        ? !METADATA.robots.index
        : true,
  nofollow:
    typeof robots?.follow !== 'undefined'
      ? !robots.follow
      : typeof METADATA?.robots?.follow !== 'undefined'
        ? !METADATA.robots.follow
        : true,
  description: resolvedDescription,
  openGraph: buildOpenGraph(adaptedOg),
  twitter: mergedTwitter,
  surpressWarnings: true,
};
---

<SEO {...seoProps} />

<link rel="alternate" hreflang="en" href={new URL(enPath, Astro.site).toString()} />
<link rel="alternate" hreflang="de" href={new URL(dePath, Astro.site).toString()} />
<link
  rel="alternate"
  hreflang="x-default"
  href={new URL(getMirrorPath(pathname, defaultLang), Astro.site).toString()}
/>
