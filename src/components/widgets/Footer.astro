---
import { getLang, localizedPath } from "~/i18n/utils";
const lang = getLang(Astro);
const en = lang === "en";
const home = localizedPath(lang, "/");
---

<footer class="fr-footer">
  <div class="fr-wrap">
    <div class="fr-footer-top">
      <a class="fr-brand" href={home}
        >frontrunner<span class="fr-brand-dot">.io</span></a
      ><p>Change with confidence.</p>
    </div>
    <div class="fr-footer-bottom">
      <span>© {new Date().getFullYear()} Frontrunner IO</span>
      <nav
        aria-label={en ? "Legal and social links" : "Rechtliches und Profile"}
      >
        <a href={localizedPath(lang, "/imprint")}
          >{en ? "Imprint" : "Impressum"}</a
        >
        <a href={localizedPath(lang, "/privacy")}
          >{en ? "Privacy" : "Datenschutz"}</a
        >
        <a href="https://www.linkedin.com/in/andreasboehrnsen/">LinkedIn ↗</a>
        <a href="https://github.com/frontrunnerio">GitHub ↗</a>
      </nav>
    </div>
  </div>
</footer>
