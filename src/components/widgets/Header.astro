---
import { getLang, getMirrorPath, localizedPath } from "~/i18n/utils";
import { getHeaderData } from "~/navigation";
import type { CallToAction } from "~/types";
export interface Props {
  links?: Array<{ text?: string; href?: string }>;
  actions?: Array<CallToAction>;
  showToggleTheme?: boolean;
  position?: string;
}
const lang = getLang(Astro);
const en = lang === "en";
const home = localizedPath(lang, "/");
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const navigation = getHeaderData(lang).links;
---

<header class="fr-header">
  <div class="fr-wrap fr-header-inner">
    <a
      class="fr-brand"
      href={home}
      aria-label={en ? "Frontrunner — homepage" : "Frontrunner — Startseite"}
    >
      <svg viewBox="0 0 32 32" fill="none" aria-hidden="true"
        ><path d="M5 26V6h22M5 16h16" stroke="currentColor" stroke-width="4"
        ></path><path d="m20 11 5 5-5 5" stroke="currentColor" stroke-width="3"
        ></path></svg
      >
      <span>frontrunner<span class="fr-brand-dot">.io</span></span>
    </a>
    <nav class="fr-nav" aria-label={en ? "Main navigation" : "Hauptnavigation"}>
      {
        navigation.map(({ href, text }) => (
          <a href={href} aria-current={path === href ? "page" : undefined}>
            {text}
          </a>
        ))
      }
    </nav>
    <a
      class="fr-language"
      href={getMirrorPath(path, en ? "de" : "en")}
      lang={en ? "de" : "en"}
      aria-label={en ? "Zur deutschen Seite" : "View this page in English"}
      >{en ? "DE" : "EN"}<span aria-hidden="true"> ↗</span></a
    >
  </div>
</header>
