---
import Layout from "~/layouts/PageLayout.astro";
import ContactCTA from "./ContactCTA.astro";
import { getLang } from "~/i18n/utils";
const en = getLang(Astro) === "en";
const principles = en
  ? [
      [
        "Start with the existing environment",
        "Applications, operational requirements and your team’s capabilities shape the solution. A new platform is useful when it solves a concrete problem.",
      ],
      [
        "Make results verifiable",
        "He agrees with your team on what improvement looks like: a deployment without undocumented steps, visible configuration differences or a tested recovery procedure.",
      ],
      [
        "Keep knowledge in your team",
        "Understandable configurations, documentation and shared implementation help your team maintain the result independently.",
      ],
    ]
  : [
      [
        "Die bestehende Umgebung als Ausgangspunkt",
        "Anwendungen, betriebliche Anforderungen und die Möglichkeiten Ihres Teams bestimmen die Lösung. Eine neue Plattform ist sinnvoll, wenn sie ein konkretes Problem löst.",
      ],
      [
        "Ergebnisse überprüfbar machen",
        "Er vereinbart mit Ihrem Team, woran eine Verbesserung erkennbar ist: eine Bereitstellung ohne undokumentierte Schritte, sichtbare Konfigurationsabweichungen oder eine erprobte Wiederherstellung.",
      ],
      [
        "Wissen im Team verfügbar machen",
        "Verständliche Konfigurationen, Dokumentation und gemeinsame Umsetzung helfen Ihrem Team, das Ergebnis eigenständig weiterzuführen.",
      ],
    ];

import Hero from "~/components/widgets/Hero.astro";
import Content from "~/components/widgets/Content.astro";
import Steps2 from "~/components/widgets/Steps2.astro";
---

<Layout
  metadata={{
    title: en
      ? "Andreas Böhrnsen — experience and approach"
      : "Andreas Böhrnsen — Erfahrung und Arbeitsweise",
    description: en
      ? "Senior DevOps and DevSecOps specialist with over 20 years in IT."
      : "Senior DevOps- und DevSecOps-Spezialist mit mehr als 20 Jahren IT-Erfahrung.",
  }}
>
  <Hero
    tagline={en ? "About Frontrunner IO" : "Über Frontrunner IO"}
    title={en ? "Andreas Böhrnsen" : "Andreas Böhrnsen"}
    subtitle={en
      ? "Andreas Böhrnsen is the specialist behind Frontrunner IO. He helps teams make changes to applications and infrastructure more reliable, from analysis to implementation and handover."
      : "Andreas Böhrnsen ist der Spezialist hinter Frontrunner IO. Er unterstützt Teams dabei, Änderungen an Anwendungen und Infrastruktur verlässlicher zu machen, von der Analyse bis zur Umsetzung und Übergabe."}
  />
  <Content
    title={en
      ? "Over 20 years of IT experience"
      : "Mehr als 20 Jahre IT-Erfahrung"}
    image={{
      src: "~/assets/images/service-coaching.jpg",
      alt: en
        ? "Illustration of sharing technical knowledge"
        : "Illustration zur Weitergabe technischen Wissens",
    }}
    callToAction={{
      text: en ? "His profile on LinkedIn" : "Sein Profil auf LinkedIn",
      href: "https://www.linkedin.com/in/andreasboehrnsen/",
    }}
  >
    <Fragment slot="content"
      ><p class="mb-5">
        {
          en
            ? "As a senior DevOps and DevSecOps specialist, his strongest areas are CI/CD, GitLab, Kubernetes, Terraform and cloud infrastructure. He applies this experience to processes that need to be repeatable, understandable and maintainable."
            : "Seine fachlichen Schwerpunkte als Senior DevOps- und DevSecOps-Spezialist liegen in CI/CD, GitLab, Kubernetes, Terraform und Cloud-Infrastruktur. Diese Erfahrung bringt er in Abläufe ein, die wiederholbar, nachvollziehbar und wartbar sein müssen."
        }
      </p><p class="mb-5">
        {
          en
            ? "He has worked for years in large regulated environments. Security, clear responsibilities and evidence of what changed are therefore part of his approach to technical implementation."
            : "Er hat über Jahre in großen regulierten Umgebungen gearbeitet. Sicherheit, klare Verantwortlichkeiten und Nachweise darüber, was geändert wurde, gehören deshalb zu seinem Verständnis technischer Umsetzung."
        }
      </p><p>
        {
          en
            ? "At Frontrunner IO, clients work directly with Andreas Böhrnsen. He contributes to the technical implementation and works through the procedures with their teams."
            : "Bei Frontrunner IO arbeiten Kunden direkt mit Andreas Böhrnsen. Er wirkt an der technischen Umsetzung mit und geht die Verfahren gemeinsam mit den Teams durch."
        }
      </p></Fragment
    >
  </Content>
  <Steps2
    title={en
      ? "His approach to working with your team."
      : "Worauf es in der Zusammenarbeit ankommt."}
    items={principles.map(([title, description]) => ({ title, description }))}
  />
  <ContactCTA />
</Layout>
