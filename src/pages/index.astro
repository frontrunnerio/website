---
import Layout from "~/layouts/PageLayout.astro";

import Hero2 from "~/components/widgets/Hero2.astro";
import Note from "~/components/widgets/Note.astro";
import Features from "~/components/widgets/Features.astro";
import Features2 from "~/components/widgets/Features2.astro";
import Steps from "~/components/widgets/Steps.astro";
import Content from "~/components/widgets/Content.astro";
import FAQs from "~/components/widgets/FAQs.astro";
import CallToAction from "~/components/widgets/CallToAction.astro";

import { BOOKING_URL } from "~/data/site";

const metadata = {
  title:
    "Frontrunner IO — Veränderung? Aber sicher! IT-Modernisierung für den Mittelstand",
  ignoreTitleTemplate: true,
  description:
    "Wir helfen kleinen und mittleren Unternehmen in Deutschland, Änderungen an ihrer IT planbar und risikoarm umzusetzen: Assessment, Plan, Pilot. Server, Datenbanken, Container, CI/CD.",
};

const hero = {
  tagline: "IT-Modernisierung für den Mittelstand",
  title:
    'Veränderung? <span class="text-accent dark:text-white highlight">Aber sicher!</span>',
  subtitle:
    "Neue Server, neue Datenbank, neue Pipeline: Jede Änderung an Ihrer IT ist ein Risiko. Wir sorgen dafür, dass Änderungen planbar, nachvollziehbar und ohne Überraschungen ablaufen. Und dass Sie dabei Geld sparen statt draufzahlen.",
  primaryCta: {
    text: "Kostenloses Assessment-Gespräch buchen",
    href: BOOKING_URL,
    target: "_blank" as const,
    icon: "tabler:calendar",
  },
  secondaryCta: { text: "Leistungen ansehen", href: "/services" },
  image: {
    src: "~/assets/images/hero-image.jpg",
    alt: "Frontrunner IO — Veränderung verlässlich machen",
  },
};

const promiseNote = {
  title: "Unser Ansatz:",
  description:
    "Kein Big Bang. Erst verstehen, dann planen, dann im Kleinen beweisen — bevor etwas Großes umgestellt wird.",
};

const problems = {
  id: "problem",
  tagline: "Kommt Ihnen das bekannt vor?",
  title: "Warum Änderungen an der IT so oft schiefgehen",
  subtitle:
    "Die meisten Ausfälle entstehen nicht durch Angriffe oder Hardware-Defekte, sondern durch Änderungen: ein Update, eine neue Konfiguration, eine Migration. Nicht, weil die Idee falsch war — sondern weil der Weg dorthin nicht abgesichert war.",
  items: [
    {
      title: "Das Wissen steckt in Köpfen, nicht in Systemen",
      description:
        "Wie der Server damals aufgesetzt wurde, weiß nur ein Kollege. Wenn der im Urlaub ist, wartet die Änderung — oder wird riskant.",
      icon: "tabler:user-question",
    },
    {
      title: "Jeder Server ist ein Unikat",
      description:
        "Manuell eingerichtet, über Jahre gewachsen, nirgends dokumentiert. Eine zweite, identische Umgebung aufzubauen ist unmöglich — und das Testen damit auch.",
      icon: "tabler:server-off",
    },
    {
      title: "Lizenzkosten steigen jedes Jahr",
      description:
        "Windows Server, Oracle, MSSQL: Die Rechnungen wachsen, der Nutzen nicht. Ein Wechsel erscheint zu riskant, also bleibt alles beim Alten.",
      icon: "tabler:receipt-2",
    },
    {
      title: "Go-Live am Freitag, Bauchschmerzen am Wochenende",
      description:
        "Änderungen werden erst in Produktion wirklich getestet, weil es keine Umgebung dafür gibt. Jeder Release ist eine kleine Mutprobe.",
      icon: "tabler:mood-sad",
    },
    {
      title: "Niemand kann sagen, was sich geändert hat",
      description:
        "Ein Problem taucht auf — aber welche der zehn Änderungen der letzten Woche war es? Ohne Nachvollziehbarkeit wird jede Fehlersuche zum Ratespiel.",
      icon: "tabler:route-x",
    },
    {
      title: "Abhängigkeit von einem einzelnen Dienstleister",
      description:
        "Der Systempartner kennt alles, dokumentiert nichts, und jede Änderung läuft über ihn. Das ist bequem — bis es das nicht mehr ist.",
      icon: "tabler:lock",
    },
  ],
};

const steps = {
  id: "ablauf",
  tagline: "So funktioniert die Zusammenarbeit",
  title: "Drei Schritte zu verlässlichen Änderungen",
  subtitle:
    "Klein anfangen, sichtbar Ergebnisse liefern, dann skalieren. So bleibt das Risiko für Sie gering — und die Entscheidung für den nächsten Schritt einfach.",
  image: {
    src: "~/assets/images/how-we-work.jpg",
    alt: "Ablauf: Assessment, Plan, Pilot",
  },
  items: [
    {
      title: 'Schritt 1: <span class="font-medium">Assessment-Gespräch</span>',
      description:
        "30 Minuten, kostenlos, per Video. Sie schildern, was ansteht oder wo es hakt. Wir stellen die richtigen Fragen und sagen Ihnen ehrlich, ob und wo wir helfen können.",
      icon: "tabler:phone-call",
    },
    {
      title: 'Schritt 2: <span class="font-medium">Konkreter Plan</span>',
      description:
        "Sie erhalten einen schriftlichen Vorschlag: Was wird geändert, in welcher Reihenfolge, mit welchem Aufwand und welchem Nutzen. Verständlich für Geschäftsführung und IT gleichermaßen.",
      icon: "tabler:list-check",
    },
    {
      title: 'Schritt 3: <span class="font-medium">Pilot-Umsetzung</span>',
      description:
        "Wir setzen einen klar abgegrenzten ersten Teil um — ein System, eine Anwendung, eine Datenbank. Sie sehen das Ergebnis, bevor Sie über den weiteren Rollout entscheiden.",
      icon: "tabler:rocket",
    },
  ],
};

const services = {
  id: "leistungen",
  tagline: "Leistungen",
  title: "Womit wir Ihre IT verlässlicher und günstiger machen",
  subtitle:
    "Sechs klar abgegrenzte Leistungen — einzeln buchbar, sinnvoll kombinierbar. Jede mit einem messbaren Ergebnis.",
  items: [
    {
      title: "CI/CD Assessment",
      description:
        "Wo verliert Ihre Software-Auslieferung Zeit, wo ist sie unsicher? Ein klarer Befund mit priorisierten Maßnahmen.",
      icon: "tabler:gauge",
      callToAction: {
        variant: "link" as const,
        text: "Mehr erfahren",
        href: "/services#cicd-assessment",
      },
    },
    {
      title: "Infrastructure as Code & Konfigurationsmanagement",
      description:
        "Server und Konfiguration werden reproduzierbar, versioniert und dokumentiert. Schluss mit Unikaten.",
      icon: "tabler:code",
      callToAction: {
        variant: "link" as const,
        text: "Mehr erfahren",
        href: "/services#infrastructure-as-code",
      },
    },
    {
      title: "Anwendungen containerisieren",
      description:
        "Ihre Anwendungen laufen überall gleich — auf dem Laptop, im Test und in Produktion.",
      icon: "tabler:box",
      callToAction: {
        variant: "link" as const,
        text: "Mehr erfahren",
        href: "/services#containerization",
      },
    },
    {
      title: "Review Apps für jede Änderung",
      description:
        "Jede Änderung bekommt automatisch eine eigene Testumgebung. Feedback vor dem Go-Live statt danach.",
      icon: "tabler:git-merge",
      callToAction: {
        variant: "link" as const,
        text: "Mehr erfahren",
        href: "/services#review-apps",
      },
    },
    {
      title: "Windows-Server zu Linux migrieren",
      description:
        "Lizenzkosten sparen, ohne den Betrieb zu gefährden. Schrittweise, System für System.",
      icon: "tabler:brand-windows",
      callToAction: {
        variant: "link" as const,
        text: "Mehr erfahren",
        href: "/services#windows-to-linux",
      },
    },
    {
      title: "Oracle & MSSQL zu PostgreSQL migrieren",
      description:
        "Raus aus teuren Datenbanklizenzen — mit sauberer Migration, Tests und Rückfallplan.",
      icon: "tabler:database",
      callToAction: {
        variant: "link" as const,
        text: "Mehr erfahren",
        href: "/services#database-migration",
      },
    },
  ],
};

const about = {
  tagline: "Wer dahintersteht",
  title: "Praxis statt Präsentation",
  contentTitle: "Ein Ansprechpartner, der selbst umsetzt",
  contentCaption:
    "Frontrunner IO ist die Beratung von Andreas Böhrnsen aus Berlin. Langjährige Erfahrung mit Infrastruktur, Automatisierung und Software-Delivery — in Konzernen, regulierten Branchen und im Mittelstand. Sie sprechen mit der Person, die auch die Arbeit macht.",
  image: {
    src: "~/assets/images/service-coaching.jpg",
    alt: "Zusammenarbeit mit Frontrunner IO",
  },
  items: [
    {
      title: "Hands-on",
      description:
        "Wir schreiben den Code, richten die Systeme ein und stehen beim Go-Live daneben. Keine Folienberatung.",
    },
    {
      title: "Verständlich",
      description:
        "Jeder Vorschlag ist so formuliert, dass Geschäftsführung und IT ihn gemeinsam bewerten können.",
    },
    {
      title: "Ohne Lock-in",
      description:
        "Alles, was wir aufbauen, ist dokumentiert und gehört Ihnen. Ihr Team kann es danach selbst weiterführen.",
    },
    {
      title: "Kleine Schritte, echte Ergebnisse",
      description:
        "Lieber ein Pilot, der läuft, als ein Konzept, das im Ordner landet.",
    },
  ],
  callToAction: {
    text: "Mehr über Frontrunner IO",
    href: "/about",
    icon: "tabler:chevron-right",
  },
};

const faqs = {
  tagline: "FAQs",
  title: "Häufig gestellte Fragen",
  subtitle:
    "Antworten auf die Fragen, die wir im ersten Gespräch am häufigsten hören.",
  items: [
    {
      title: "Für wen ist das Angebot gedacht?",
      description:
        "Für kleine und mittlere Unternehmen in Deutschland, die eigene Software betreiben oder entwickeln — typischerweise mit 20 bis 500 Mitarbeitenden und einem kleinen IT-Team oder externen Dienstleister. Wenn Sie Änderungen an Ihrer IT scheuen, weil sie riskant oder teuer sind, sind Sie richtig.",
    },
    {
      title: "Was kostet das Assessment-Gespräch?",
      description:
        "Nichts. 30 Minuten per Video, ohne Verpflichtung. Sie bekommen in jedem Fall eine ehrliche Einschätzung — auch wenn wir am Ende sagen, dass Sie uns nicht brauchen.",
    },
    {
      title: "Müssen wir alles auf einmal umstellen?",
      description:
        "Nein — genau das Gegenteil. Wir starten mit einem Pilot, der klar abgegrenzt ist: eine Anwendung, ein Server, eine Datenbank. Erst wenn der läuft, entscheiden Sie über den nächsten Schritt.",
    },
    {
      title: "Wie schnell sehen wir Ergebnisse?",
      description:
        "Den Plan erhalten Sie innerhalb von ein bis zwei Wochen nach dem Gespräch. Ein Pilot dauert je nach Umfang zwei bis acht Wochen. Kosteneinsparungen durch Lizenzwechsel werden ab dem Monat sichtbar, in dem das System umgezogen ist.",
    },
    {
      title: "Was passiert, wenn der Pilot nicht funktioniert?",
      description:
        "Dann haben Sie etwas gelernt, das wenig gekostet hat. Jeder Pilot hat einen Rückfallplan; die bestehenden Systeme laufen währenddessen unverändert weiter. Das ist der Sinn eines Piloten.",
    },
    {
      title: "Arbeiten Sie vor Ort oder remote?",
      description:
        "Überwiegend remote, mit Terminen vor Ort, wo sie sinnvoll sind — zum Beispiel beim Kick-off oder beim Go-Live. Standort ist Berlin, Kunden sitzen in ganz Deutschland.",
    },
  ],
};

const cta = {
  primaryCta: {
    text: "Kostenloses Assessment-Gespräch buchen",
    href: BOOKING_URL,
    target: "_blank" as const,
    icon: "tabler:calendar",
  },
  secondaryCta: {
    text: "Oder per E-Mail anfragen",
    href: "mailto:info@frontrunner.io",
  },
  title: "Welche Änderung schieben Sie schon länger vor sich her?",
  subtitle:
    "30 Minuten, kostenlos, ohne Verkaufsdruck. Am Ende wissen Sie, ob und wie sich die Änderung sicher umsetzen lässt.",
};

const heroActions = [
  { variant: "primary" as const, ...hero.primaryCta },
  { text: hero.secondaryCta.text, href: hero.secondaryCta.href },
];

const ctaActions = [
  { variant: "primary" as const, ...cta.primaryCta },
  { variant: "secondary" as const, ...cta.secondaryCta },
];
---

<Layout metadata={metadata}>
  <Hero2
    tagline={hero.tagline}
    title={hero.title}
    subtitle={hero.subtitle}
    actions={heroActions}
    image={hero.image}
  />

  <Note title={promiseNote.title} description={promiseNote.description} />

  <Features
    id={problems.id}
    tagline={problems.tagline}
    title={problems.title}
    subtitle={problems.subtitle}
    items={problems.items}
  />

  <Steps
    id={steps.id}
    tagline={steps.tagline}
    title={steps.title}
    subtitle={steps.subtitle}
    items={steps.items}
    image={steps.image}
  >
    <Fragment slot="bg"
      ><div class="absolute inset-0 bg-blue-50 dark:bg-transparent">
      </div></Fragment
    >
  </Steps>

  <Features2
    id={services.id}
    tagline={services.tagline}
    title={services.title}
    subtitle={services.subtitle}
    columns={3}
    items={services.items}
  />

  <Content
    isReversed
    tagline={about.tagline}
    title={about.title}
    items={about.items}
    image={about.image}
    callToAction={about.callToAction}
  >
    <Fragment slot="content">
      <h3
        class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2"
      >
        {about.contentTitle}
      </h3>
      {about.contentCaption}
    </Fragment>
    <Fragment slot="bg"
      ><div class="absolute inset-0 bg-blue-50 dark:bg-transparent">
      </div></Fragment
    >
  </Content>

  <FAQs
    title={faqs.title}
    subtitle={faqs.subtitle}
    tagline={faqs.tagline}
    classes={{ container: "max-w-6xl" }}
    items={faqs.items}
  />

  <CallToAction actions={ctaActions}>
    <Fragment slot="title">{cta.title}</Fragment>
    <Fragment slot="subtitle">{cta.subtitle}</Fragment>
  </CallToAction>
</Layout>
