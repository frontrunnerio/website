---
import Layout from "~/layouts/PageLayout.astro";
import Image from "~/components/common/Image.astro";
import { Icon } from "astro-icon/components";
import ConsultationCta from "~/components/widgets/ConsultationCta.astro";

const heroImage =
  "https://images.unsplash.com/photo-1558494949-ef010cbdcc31?auto=format&fit=crop&w=1920&q=85";
const metadata = {
  title: "Frontrunner IO | Weniger Feuer löschen. Mehr verlässliche IT.",
  ignoreTitleTemplate: true,
  description:
    "Abweichende Umgebungen, riskante Änderungen, zu viel Handarbeit? Frontrunner IO macht Software und Infrastruktur nachvollziehbar und reproduzierbar. Jetzt Erstgespräch anfragen.",
  openGraph: { images: [{ url: heroImage, width: 1920, height: 1080 }] },
};
const pains = [
  {
    title: "„Im Test lief es doch noch.“",
    body: "Andere Versionen, ein zusätzlicher Parameter, eine manuelle Änderung. Ihr Team sucht nach Unterschieden, statt am eigentlichen Problem zu arbeiten.",
    cost: "Die Folge: längere Fehlersuche und Unsicherheit beim nächsten Deployment.",
    link: "Umgebungen in Einklang bringen",
    topic: "drift",
  },
  {
    title: "„Wer hat das zuletzt geändert?“",
    body: "Die Antwort steckt irgendwo zwischen Tickets, Skripten und Chatverläufen. Ob ein Eingriff gewollt war und wie Sie ihn rückgängig machen, bleibt offen.",
    cost: "Die Folge: riskante Änderungen und aufwendige Rekonstruktion im Störungsfall.",
    link: "Änderungen nachvollziehbar machen",
    topic: "changes",
  },
  {
    title: "„Das weiß nur eine Person.“",
    body: "Ein System neu aufzusetzen braucht Erfahrung, Geduld und die richtige Person. Die Dokumentation beschreibt einen Stand, der längst nicht mehr existiert.",
    cost: "Die Folge: Abhängigkeiten im Team und schwer planbare Wiederherstellung.",
    link: "Wissen im System verankern",
    topic: "recovery",
  },
];
const services = [
  {
    title: "Verstehen, wo das Risiko steckt.",
    body: "Wir nehmen ein relevantes System unter die Lupe: Konfigurationen, Abhängigkeiten, manuelle Eingriffe und Verantwortlichkeiten.",
    results: [
      "Überblick über Istzustand und Abweichungen",
      "Priorisierte Risiken und nächste Schritte",
      "Ein klar abgegrenzter Pilot statt Großprojekt",
    ],
  },
  {
    title: "Aus Handarbeit einen verlässlichen Ablauf machen.",
    body: "Wir versionieren Konfigurationen, automatisieren geeignete Schritte und integrieren Prüfungen in Ihre vorhandenen Abläufe.",
    results: [
      "Versionierte Konfigurationen und feste Abhängigkeiten",
      "Reviewbare Änderungen mit definierten Freigaben",
      "Automatisierte Prüfungen auf unerwünschte Abweichungen",
    ],
  },
  {
    title: "Sicherstellen, dass es ohne uns weitergeht.",
    body: "Wir erproben den vereinbarten Systemstand und die Wiederherstellung gemeinsam mit Ihrem Team. Wissen und Verantwortung bleiben bei Ihnen.",
    results: [
      "Praktisch geprüfte Wiederherstellung im vereinbarten Umfang",
      "Dokumentierte Abläufe und bekannte Grenzen",
      "Übergabe und Coaching im tatsächlichen Arbeitskontext",
    ],
  },
];
const steps = [
  {
    title: "Situation besprechen",
    text: "Wo entstehen Aufwand und Unsicherheit? Im Erstgespräch klären wir, ob und wie wir helfen können.",
  },
  {
    title: "Umfang vereinbaren",
    text: "Wir legen System, Ergebnisse, Aufwand und Abnahmekriterien fest. Erst dann beginnt der Auftrag.",
  },
  {
    title: "Gemeinsam umsetzen",
    text: "Wir arbeiten an einem konkreten Pilot. Änderungen werden mit Ihrem Team abgestimmt und geprüft.",
  },
  {
    title: "Nachweisen & übergeben",
    text: "Wir prüfen die vereinbarten Ergebnisse und übergeben Dokumentation und Abläufe an Ihr Team.",
  },
];
const faqs = [
  {
    title: "Für welche Unternehmen ist das sinnvoll?",
    text: "Für Unternehmen mit gewachsenen Software- und Infrastrukturumgebungen, in denen Unterschiede zwischen Systemen, manuelle Eingriffe oder fehlende Nachvollziehbarkeit regelmäßig Aufwand verursachen. Ansprechpartner sind häufig IT-Verantwortliche, Plattform- und Betriebsteams.",
  },
  {
    title: "Müssen wir unsere Tools oder Plattform wechseln?",
    text: "Nein. Wir beginnen mit dem, was Sie bereits einsetzen. Git, Ansible, Terraform und CI/CD können helfen, sind aber kein Selbstzweck. Ein Toolwechsel ist nur dann Thema, wenn er für Ihr konkretes Problem sinnvoll ist.",
  },
  {
    title: "Müssen wir dafür den laufenden Betrieb umbauen?",
    text: "Nicht auf einmal. Wir begrenzen den Einstieg auf ein System oder einen Ablauf. Zugriff, Testmöglichkeiten, Änderungsfenster und Rückfallwege vereinbaren wir vor der Umsetzung. Eingriffe in Produktivsysteme erfolgen nur nach Ihrer Freigabe.",
  },
  {
    title: "Was kostet die Zusammenarbeit?",
    text: "Das Erstgespräch ist unverbindlich. Für einen Auftrag erhalten Sie ein Angebot auf Basis des vereinbarten Umfangs, der vorhandenen Umgebung und der gewünschten Ergebnisse. Es gibt keine automatische Beauftragung durch eine Anfrage.",
  },
  {
    title: "Was bedeutet Konfigurationsmanagement konkret?",
    text: "Zu wissen, welche Komponenten, Versionen und Einstellungen einen Systemstand bilden, Änderungen kontrolliert durchzuführen und den tatsächlichen Zustand zu überprüfen. Die Technik dahinter soll Ihren Alltag einfacher machen, nicht zusätzliche Bürokratie erzeugen.",
  },
  {
    title: "Brauchen Sie schon im Erstgespräch Systemzugriff?",
    text: "Nein. Eine Beschreibung Ihrer Situation reicht für den Einstieg. Bitte senden Sie keine Passwörter, Zugangsdaten oder vertraulichen Systemdetails. Benötigte Zugriffe und den Umgang mit sensiblen Informationen klären wir bei einer Zusammenarbeit gesondert.",
  },
];
---

<Layout metadata={metadata}>
  <section class="hero" aria-labelledby="hero-title">
    <Image
      src={heroImage}
      alt="Serverracks und Verkabelung in einem Rechenzentrum"
      width={1920}
      height={1080}
      loading="eager"
      fetchpriority="high"
      class="hero-photo"
    />
    <div class="site-container hero-inner">
      <p class="eyebrow">Frontrunner IO · Beratung & Umsetzung</p>
      <p class="hero-catch">Weniger Feuer löschen.</p>
      <h1 id="hero-title">Mehr verlässliche IT.</h1>
      <p class="hero-description">
        Wenn Umgebungen auseinanderlaufen und jede Änderung zur Unsicherheit
        wird, braucht Ihr Team mehr als ein weiteres Tool. Wir machen
        Konfigurationen nachvollziehbar und Systeme reproduzierbar.
      </p>
      <div class="hero-actions">
        <a class="action action-lime" href="/contact" data-consultation="hero"
          >Erstgespräch anfragen <Icon name="tabler:arrow-up-right" /></a
        >
        <a class="text-link" href="#leistungen"
          >Leistungen ansehen <Icon name="tabler:arrow-down" /></a
        >
      </div>
      <p class="hero-reassurance">
        Unverbindlich. Direkt mit Andreas Böhrnsen. Ohne Systemzugriff zum
        Einstieg.
      </p>
    </div>
    <a class="image-credit" href="https://unsplash.com/photos/M5tzZtFCOfs"
      >Foto: Taylor Vick / Unsplash</a
    >
  </section>

  <section class="benefits-strip" aria-label="Was sich für Sie verändert">
    <div class="site-container benefits-inner">
      <div class="benefit">
        <Icon name="tabler:list-search" /><div>
          <h2>Weniger Rätselraten</h2><p>
            Wissen, welcher Stand tatsächlich läuft.
          </p>
        </div>
      </div>
      <div class="benefit">
        <Icon name="tabler:git-pull-request" /><div>
          <h2>Mehr Kontrolle</h2><p>Änderungen prüfen und nachvollziehen.</p>
        </div>
      </div>
      <div class="benefit">
        <Icon name="tabler:restore" /><div>
          <h2>Weniger Abhängigkeit</h2><p>
            Systeme mit dokumentierten Abläufen aufbauen.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="herausforderungen">
    <div class="site-container">
      <div class="section-heading">
        <p class="eyebrow">Kommt Ihnen das bekannt vor?</p><h2>
          Ihre IT funktioniert.<br />Bis jemand etwas ändert.
        </h2><p>
          Das Problem ist oft nicht die einzelne Störung. Es ist die fehlende
          Gewissheit darüber, wie Ihre Systeme wirklich konfiguriert sind.
        </p>
      </div>
      <div class="pain-grid">
        {
          pains.map((pain, i) => (
            <article class="pain-item">
              <>
                <span class="pain-number">0{i + 1}</span>
                <h3>{pain.title}</h3>
                <p>{pain.body}</p>
                <div class="pain-cost">{pain.cost}</div>
                <a
                  class="text-link"
                  href={"/contact?thema=" + pain.topic}
                  data-consultation={"pain-" + pain.topic}
                >
                  {pain.link}
                  <Icon name="tabler:arrow-up-right" />
                </a>
              </>
            </article>
          ))
        }
      </div>
      <p class="pain-footer">
        Für IT-Verantwortliche, Plattform- und Betriebsteams mit gewachsenen
        Systemlandschaften.
      </p>
    </div>
  </section>

  <section class="section section-mist">
    <div class="site-container results-layout">
      <div>
        <p class="eyebrow">Das Ziel: ein beherrschbarer Betrieb</p><h2>
          Aus „müsste so sein“<br />wird „ist nachvollziehbar“.
        </h2><p class="section-intro">
          Konfigurationsmanagement ist die Methode. Der Nutzen: Ihr Team kann
          Zustände erklären, Änderungen beurteilen und Systeme wieder aufbauen.
        </p>
        <ul class="outcome-list">
          <li>
            <Icon name="tabler:check" /><div>
              <strong>Ein bekannter Ausgangspunkt</strong><span
                >Versionen, Einstellungen und Abhängigkeiten sind festgehalten.</span>
            </div>
          </li>
          <li>
            <Icon name="tabler:check" /><div>
              <strong>Ein nachvollziehbarer Änderungsweg</strong><span
                >Sie erkennen, was geändert, geprüft und freigegeben wurde.</span>
            </div>
          </li>
          <li>
            <Icon name="tabler:check" /><div>
              <strong>Ein praktisch geprüfter Wiederaufbau</strong><span
                >Wiederherstellung wird erprobt, statt nur dokumentiert.</span>
            </div>
          </li>
        </ul>
      </div>
      <div>
        <div class="reference-sheet">
          <div class="reference-title">
            <small>BEISPIEL · DOKUMENTIERTER REFERENZSTAND</small><h3>
              Ein System. Ein bekannter Stand.
            </h3>
          </div>
          <dl>
            <div><dt>System</dt><dd>Kundenportal · Produktion</dd></div>
            <div>
              <dt>Software & Abhängigkeiten</dt><dd>Versionen festgelegt</dd>
            </div>
            <div><dt>Konfiguration</dt><dd>Versioniert in Git</dd></div>
            <div>
              <dt>Letzte Änderung</dt><dd>Review und Freigabe verknüpft</dd>
            </div>
            <div><dt>Verantwortung</dt><dd>Betriebsteam benannt</dd></div>
            <div>
              <dt>Wiederherstellung</dt><dd>Ablauf und Test dokumentiert</dd>
            </div>
          </dl>
          <p class="reference-note">
            Nicht nur ein Inventar. Eine Grundlage für Entscheidungen und den
            nächsten Eingriff.
          </p>
        </div>
        <p class="reference-caption">
          Vereinfachtes Beispiel, kein Kundenprojekt oder reales Prüfergebnis.
        </p>
      </div>
    </div>
  </section>

  <section class="section" id="leistungen">
    <div class="site-container">
      <div class="section-heading">
        <p class="eyebrow">Unsere Leistungen</p><h2>
          Wir klären nicht nur auf.<br />Wir setzen mit Ihnen um.
        </h2><p>
          Von der ersten Bestandsaufnahme bis zu Abläufen, die Ihr Team
          eigenständig weiterführt. Passend zu Ihrer Umgebung, nicht zu einer
          vorgegebenen Plattform.
        </p>
      </div>
      {
        services.map((service, i) => (
          <article class="service-row">
            <>
              <span class="service-number">0{i + 1}</span>
              <div>
                <>
                  <h3>{service.title}</h3>
                  <p>{service.body}</p>
                </>
              </div>
              <ul aria-label="Ergebnisse">
                {service.results.map((result) => (
                  <li>
                    <Icon name="tabler:check" />
                    {result}
                  </li>
                ))}
              </ul>
            </>
          </article>
        ))
      }
      <div class="tools-line">
        <p>Der Prozess führt. Die Werkzeuge unterstützen.</p><div
          class="tools-list"
        >
          <span><Icon name="tabler:brand-git" />Git</span><span
            ><Icon name="tabler:terminal-2" />Ansible</span
          ><span><Icon name="tabler:brand-terraform" />Terraform</span><span
            ><Icon name="tabler:brand-gitlab" />GitLab / CI/CD</span>
        </div>
      </div>
    </div>
  </section>

  <section class="starter-section" id="einstieg">
    <div class="site-container starter-inner">
      <div>
        <p class="eyebrow">Ein überschaubarer Einstieg</p><h2>
          Ein System.<br />Ein klarer Anfang.
        </h2><p class="starter-copy">
          Sie müssen nicht Ihre gesamte IT neu aufstellen. Wir beginnen dort, wo
          Unklarheit gerade Aufwand verursacht, und vereinbaren eine gezielte
          Bestandsaufnahme.
        </p><a
          class="action action-lime"
          href="/contact?thema=overview"
          data-consultation="assessment"
          >Einstieg besprechen <Icon name="tabler:arrow-up-right" /></a>
      </div>
      <div class="starter-deliverables">
        <h3>Das Ergebnis der Bestandsaufnahme</h3><ol>
          <li>
            <strong>Ein gemeinsames Bild</strong><p>
              Welche Konfigurationen und Abhängigkeiten sind relevant?
            </p>
          </li><li>
            <strong>Eine klare Priorität</strong><p>
              Welche Lücken verursachen den größten Aufwand oder das größte
              Risiko?
            </p>
          </li><li>
            <strong>Ein konkreter nächster Schritt</strong><p>
              Welcher Pilot ist sinnvoll, und woran messen wir das Ergebnis?
            </p>
          </li>
        </ol><p class="starter-note">
          Umfang und Vergütung vereinbaren wir vor Beginn. Das Erstgespräch
          verpflichtet Sie zu keinem Auftrag.
        </p>
      </div>
    </div>
  </section>

  <section class="section" id="vorgehen">
    <div class="site-container">
      <div class="section-heading">
        <p class="eyebrow">So arbeiten wir zusammen</p><h2>
          Kein Großprojekt auf Verdacht.
        </h2><p>
          Ein klarer Umfang, gemeinsame Entscheidungen und überprüfbare
          Ergebnisse. Schritt für Schritt.
        </p>
      </div>
      <div class="process-grid">
        {
          steps.map((step, i) => (
            <article class="process-step">
              <>
                <span class="step">SCHRITT 0{i + 1}</span>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </>
            </article>
          ))
        }
      </div>
      <div class="advisor-band">
        <div class="advisor-monogram" aria-hidden="true">AB</div><div>
          <strong>Andreas Böhrnsen</strong><p>
            Ihr Ansprechpartner · Frontrunner IO, Berlin
          </p>
        </div><a class="text-link" href="/about"
          >Mehr über die Zusammenarbeit <Icon
            name="tabler:arrow-up-right"
          /></a>
      </div>
    </div>
  </section>

  <section class="section section-mist" id="fragen">
    <div class="site-container faq-layout">
      <div>
        <p class="eyebrow">Vor dem ersten Gespräch</p><h2>
          Gute Fragen.<br />Klare Antworten.
        </h2>
      </div>
      <div class="faq-list">
        {
          faqs.map((faq) => (
            <details>
              <>
                <summary>
                  {faq.title}
                  <Icon name="tabler:plus" />
                </summary>
                <p>{faq.text}</p>
              </>
            </details>
          ))
        }
      </div>
    </div>
  </section>
  <ConsultationCta />
</Layout>
