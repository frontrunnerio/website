---
import Layout from "~/layouts/PageLayout.astro";
import HeroText from "~/components/widgets/HeroText.astro";
import Features2 from "~/components/widgets/Features2.astro";
import Steps2 from "~/components/widgets/Steps2.astro";

import { BOOKING_URL, CONTACT_EMAIL, CONTACT_PHONE } from "~/data/site";

const metadata = {
  title: "Contact",
  description:
    "Book a free assessment call or send us a message — we usually reply within one business day.",
};

const hero = {
  tagline: "Contact",
  title: "The easiest first step: a conversation.",
  subtitle:
    "30 minutes, free, by video. You tell us what is coming up — we tell you honestly whether and how we can help.",
  callToAction: {
    text: "Book an assessment call",
    href: BOOKING_URL,
    icon: "tabler:calendar",
  },
};

const direct = {
  title: "Or get in touch directly",
  subtitle: "We usually reply within one business day.",
  items: [
    {
      title: "Email",
      description: `<a href="mailto:${CONTACT_EMAIL}" class="hover:underline">${CONTACT_EMAIL}</a>`,
      icon: "tabler:mail",
    },
    { title: "Phone", description: CONTACT_PHONE, icon: "tabler:headset" },
    {
      title: "Location",
      description: "Berlin, Germany<br>Clients across Germany, mostly remote",
      icon: "tabler:map-pin",
    },
  ],
};

const expect = {
  title: "What to expect in the call",
  subtitle:
    "Not a sales pitch. A structured first conversation that leaves you better informed than before.",
  items: [
    {
      title: "Your situation",
      description:
        "What is coming up, what hurts, what has been tried already? We listen and ask questions.",
      icon: "tabler:message-circle",
    },
    {
      title: "Our honest assessment",
      description:
        "Where do we see the biggest lever — and where would we advise against? Even if that means you do not need us.",
      icon: "tabler:bulb",
    },
    {
      title: "A concrete next step",
      description:
        "If it fits, you receive a written proposal for an assessment or pilot within a few days.",
      icon: "tabler:arrow-right",
    },
  ],
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline={hero.tagline}
    title={hero.title}
    subtitle={hero.subtitle}
    callToAction={hero.callToAction}
  />

  <Steps2 title={expect.title} subtitle={expect.subtitle} items={expect.items}>
    <Fragment slot="bg"
      ><div class="absolute inset-0 bg-blue-50 dark:bg-transparent">
      </div></Fragment
    >
  </Steps2>

  <Features2
    title={direct.title}
    subtitle={direct.subtitle}
    items={direct.items}
  />
</Layout>
