---
import Layout from "~/layouts/PageLayout.astro";

import Hero2 from "~/components/widgets/Hero2.astro";
import Note from "~/components/widgets/Note.astro";
import Features from "~/components/widgets/Features.astro";
import Features2 from "~/components/widgets/Features2.astro";
import Steps from "~/components/widgets/Steps.astro";
import Content from "~/components/widgets/Content.astro";
import FAQs from "~/components/widgets/FAQs.astro";
import CallToAction from "~/components/widgets/CallToAction.astro";

import { BOOKING_URL } from "~/data/site";

const metadata = {
  title:
    "Frontrunner IO — Change with confidence. IT modernisation for German SMEs",
  ignoreTitleTemplate: true,
  description:
    "Modernise your IT without putting operations at risk: we help small and mid-sized companies cut IT costs and replace ageing systems — in small steps with clear results. Free assessment call.",
};

const hero = {
  tagline: "IT modernisation for small and mid-sized companies",
  title:
    'Change with <span class="text-accent dark:text-white highlight">confidence</span>.',
  subtitle:
    "You want to cut IT costs, replace ageing systems or finally bring order to your infrastructure — but every change feels risky? We make change predictable: small steps, clear results, no downtime for the business.",
  primaryCta: {
    text: "Book a free assessment call",
    href: BOOKING_URL,
    target: "_blank" as const,
    icon: "tabler:calendar",
  },
  secondaryCta: { text: "See our services", href: "/en/services" },
  image: {
    src: "~/assets/images/hero-image.jpg",
    alt: "Frontrunner IO — Change with confidence",
  },
};

const promiseNote = {
  title: "Our approach:",
  description:
    "No big bang. Understand first, then plan, then prove it on a small scale — before anything big gets switched over.",
};

const problems = {
  id: "problem",
  tagline: "Sound familiar?",
  title: "Why IT changes go wrong so often",
  subtitle:
    "Most IT outages aren't caused by attacks or broken hardware, but by changes: an update, a new setting, a move. Not because the idea was wrong, but because the path there wasn't secured.",
  items: [
    {
      title: "Knowledge lives in heads, not in systems",
      description:
        "Only one colleague knows how that server was set up back then. When they're on holiday, the change waits — or gets risky.",
      icon: "tabler:user-question",
    },
    {
      title: "Every server is a one-off",
      description:
        "Set up by hand, grown over years, documented nowhere. Building a second, identical environment is impossible — and so is testing.",
      icon: "tabler:server-off",
    },
    {
      title: "Licence costs rise every year",
      description:
        "Windows Server, Oracle, MSSQL: the invoices grow, the value doesn't. Switching feels too risky, so everything stays as it is.",
      icon: "tabler:receipt-2",
    },
    {
      title: "Go-live on Friday, stomach ache all weekend",
      description:
        "Changes are only really tested in production because there's no environment for it. Every update is a small act of courage.",
      icon: "tabler:mood-sad",
    },
    {
      title: "Nobody can say what changed",
      description:
        "A problem shows up — but which of last week’s ten changes caused it? Without traceability, every investigation becomes guesswork.",
      icon: "tabler:route-x",
    },
    {
      title: "Dependence on a single vendor",
      description:
        "Your IT partner knows everything, documents nothing, and every change goes through them. That's convenient — until it isn't.",
      icon: "tabler:lock",
    },
  ],
};

const steps = {
  id: "how-it-works",
  tagline: "How we work together",
  title: "Three steps to reliable change",
  subtitle:
    "Start small, deliver visible results, then scale. Your risk stays low — and the decision about the next step stays easy.",
  image: {
    src: "~/assets/images/how-we-work.jpg",
    alt: "Process: assessment, plan, pilot",
  },
  items: [
    {
      title: 'Step 1: <span class="font-medium">Assessment call</span>',
      description:
        "30 minutes, free, by video. You describe what's coming up or where things are stuck. We ask the right questions and tell you honestly whether and where we can help.",
      icon: "tabler:phone-call",
    },
    {
      title: 'Step 2: <span class="font-medium">Concrete plan</span>',
      description:
        "You receive a written proposal: what changes, in which order, with what effort and what benefit. Written so that management and IT can evaluate it together.",
      icon: "tabler:list-check",
    },
    {
      title: 'Step 3: <span class="font-medium">Pilot implementation</span>',
      description:
        "We implement a clearly scoped first piece — one system, one application, one database. You see the result before you decide on the wider rollout.",
      icon: "tabler:rocket",
    },
  ],
};

const services = {
  id: "services",
  tagline: "Services",
  title: "How we make your IT more reliable and less expensive",
  subtitle:
    "Each service solves one concrete problem and can be booked on its own. You start where it hurts most — or saves most.",
  items: [
    {
      title: "Software delivery check",
      description:
        "Updates take forever or go wrong? We find out where things get stuck — and what to fix first.",
      icon: "tabler:gauge",
      callToAction: {
        variant: "link" as const,
        text: "Learn more",
        href: "/en/services#cicd-assessment",
      },
    },
    {
      title: "Infrastructure as code",
      description:
        "Only one colleague knows how the server is set up? We make your infrastructure documented, reviewable and rebuildable in minutes.",
      icon: "tabler:code",
      callToAction: {
        variant: "link" as const,
        text: "Learn more",
        href: "/en/services#infrastructure-as-code",
      },
    },
    {
      title: "Containerising applications",
      description:
        "“Works on my machine” — but not in production? We make your applications run the same everywhere.",
      icon: "tabler:box",
      callToAction: {
        variant: "link" as const,
        text: "Learn more",
        href: "/en/services#containerization",
      },
    },
    {
      title: "Test environments per change",
      description:
        "Bugs only show up after the update? Every change gets its own test environment first — click through it, try it out.",
      icon: "tabler:git-merge",
      callToAction: {
        variant: "link" as const,
        text: "Learn more",
        href: "/en/services#review-apps",
      },
    },
    {
      title: "Replacing server licences",
      description:
        "Windows Server licences eating your budget? We move your systems to Linux step by step — no downtime, permanent savings.",
      icon: "tabler:brand-windows",
      callToAction: {
        variant: "link" as const,
        text: "Learn more",
        href: "/en/services#windows-to-linux",
      },
    },
    {
      title: "Replacing database licences",
      description:
        "Oracle or Microsoft SQL Server your biggest IT line item? We migrate to PostgreSQL — checked, tested, with a rollback plan.",
      icon: "tabler:database",
      callToAction: {
        variant: "link" as const,
        text: "Learn more",
        href: "/en/services#database-migration",
      },
    },
    {
      title: "Cloud migration within the EU",
      description:
        "Your own server room, ageing hardware, maintenance contracts? We move you to the cloud — with providers in Germany and the EU. You pay only for what you use.",
      icon: "tabler:cloud-upload",
      callToAction: {
        variant: "link" as const,
        text: "Learn more",
        href: "/en/services#cloud-migration",
      },
    },
  ],
};

const about = {
  tagline: "Who is behind it",
  title: "Practice, not presentations",
  contentTitle: "One contact who does the work",
  contentCaption:
    "Frontrunner IO is the consultancy of Andreas Böhrnsen, based in Berlin. Many years of experience with infrastructure, automation and software delivery — in enterprises, regulated industries and mid-sized companies. You talk to the person who also does the work.",
  image: {
    src: "~/assets/images/service-coaching.jpg",
    alt: "Working with Frontrunner IO",
  },
  items: [
    {
      title: "Hands-on",
      description:
        "We write the code, set up the systems and stand next to you at go-live. No slide-deck consulting.",
    },
    {
      title: "Understandable",
      description:
        "Every proposal is written so that management and IT can evaluate it together.",
    },
    {
      title: "No lock-in",
      description:
        "Everything we build is documented and belongs to you. Your team can carry it forward on their own.",
    },
    {
      title: "Small steps, real results",
      description:
        "Better a pilot that runs than a concept that ends up in a folder.",
    },
  ],
  callToAction: {
    text: "More about Frontrunner IO",
    href: "/en/about",
    icon: "tabler:chevron-right",
  },
};

const faqs = {
  tagline: "FAQs",
  title: "Frequently asked questions",
  subtitle: "Answers to the questions we hear most often in the first call.",
  items: [
    {
      title: "Who is this for?",
      description:
        "Small and mid-sized companies in Germany that run or build their own software — typically 20 to 500 employees with a small IT team or an external provider. If you avoid changes to your IT because they feel risky or expensive, you're in the right place.",
    },
    {
      title: "What does the assessment call cost?",
      description:
        "Nothing. 30 minutes by video, no obligation. You get an honest assessment either way — even if we end up telling you that you don't need us.",
    },
    {
      title: "What does a pilot cost?",
      description:
        "That depends on the scope. You receive a fixed-price offer before we start — no open-ended timesheets, no surprises on the invoice.",
    },
    {
      title: "We don't have our own developers — does this still fit?",
      description:
        "Yes. Most of our services concern operations — servers, databases, cloud — not software development. We work with your administrator or your IT provider.",
    },
    {
      title: "Do we have to switch everything at once?",
      description:
        "No — quite the opposite. We start with a clearly scoped pilot: one application, one server, one database. Only when it runs do you decide on the next step.",
    },
    {
      title: "How quickly will we see results?",
      description:
        "You receive the plan within one to two weeks after the call. A pilot takes two to eight weeks depending on scope. Licence savings show up from the month the system is moved.",
    },
    {
      title: "What if the pilot doesn't work?",
      description:
        "Then you've learned something that cost little. Every pilot has a rollback plan; your existing systems keep running unchanged in the meantime. That's the point of a pilot.",
    },
    {
      title: "Do you work on-site or remotely?",
      description:
        "Mostly remotely, with on-site visits where they make sense — for example at kick-off or go-live. Based in Berlin, working with clients across Germany.",
    },
  ],
};

const cta = {
  primaryCta: {
    text: "Book a free assessment call",
    href: BOOKING_URL,
    target: "_blank" as const,
    icon: "tabler:calendar",
  },
  secondaryCta: {
    text: "Or send an email",
    href: "mailto:info@frontrunner.io",
  },
  title: "Which change have you been putting off?",
  subtitle:
    "30 minutes, free, no sales pressure. By the end you'll know whether and how the change can be made safely.",
};

const heroActions = [
  { variant: "primary" as const, ...hero.primaryCta },
  { text: hero.secondaryCta.text, href: hero.secondaryCta.href },
];

const ctaActions = [
  { variant: "primary" as const, ...cta.primaryCta },
  { variant: "secondary" as const, ...cta.secondaryCta },
];
---

<Layout metadata={metadata}>
  <Hero2
    tagline={hero.tagline}
    title={hero.title}
    subtitle={hero.subtitle}
    actions={heroActions}
    image={hero.image}
  />

  <Note title={promiseNote.title} description={promiseNote.description} />

  <Features
    id={problems.id}
    tagline={problems.tagline}
    title={problems.title}
    subtitle={problems.subtitle}
    items={problems.items}
  />

  <Steps
    id={steps.id}
    tagline={steps.tagline}
    title={steps.title}
    subtitle={steps.subtitle}
    items={steps.items}
    image={steps.image}
  >
    <Fragment slot="bg"
      ><div class="absolute inset-0 bg-blue-50 dark:bg-transparent">
      </div></Fragment
    >
  </Steps>

  <Features2
    id={services.id}
    tagline={services.tagline}
    title={services.title}
    subtitle={services.subtitle}
    columns={3}
    items={services.items}
  />

  <Content
    isReversed
    tagline={about.tagline}
    title={about.title}
    items={about.items}
    image={about.image}
    callToAction={about.callToAction}
  >
    <Fragment slot="content">
      <h3
        class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2"
      >
        {about.contentTitle}
      </h3>
      {about.contentCaption}
    </Fragment>
    <Fragment slot="bg"
      ><div class="absolute inset-0 bg-blue-50 dark:bg-transparent">
      </div></Fragment
    >
  </Content>

  <FAQs
    title={faqs.title}
    subtitle={faqs.subtitle}
    tagline={faqs.tagline}
    classes={{ container: "max-w-6xl" }}
    items={faqs.items}
  />

  <CallToAction actions={ctaActions}>
    <Fragment slot="title">{cta.title}</Fragment>
    <Fragment slot="subtitle">{cta.subtitle}</Fragment>
  </CallToAction>
</Layout>
