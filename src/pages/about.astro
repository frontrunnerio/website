---
import Layout from "~/layouts/PageLayout.astro";
import Image from "~/components/common/Image.astro";
import { Icon } from "astro-icon/components";
import ConsultationCta from "~/components/widgets/ConsultationCta.astro";
const metadata = {
  title: "Über Frontrunner IO | Direkte Beratung und praktische Umsetzung",
  ignoreTitleTemplate: true,
  description:
    "Andreas Böhrnsen begleitet Sie von der Bestandsaufnahme bis zur Umsetzung. Konfigurationsmanagement, Automatisierung und Wissenstransfer für verlässliche IT.",
};
---

<Layout metadata={metadata}>
  <section class="subpage-hero site-container">
    <p class="eyebrow">Über Frontrunner IO</p><h1>
      Beratung mit Verantwortung.<br />Und direktem Draht.
    </h1>
    <p class="lead">
      Hinter Frontrunner IO steht Andreas Böhrnsen. Ihr Ansprechpartner für
      nachvollziehbare Konfigurationen und einen Betrieb, der weniger von
      Handarbeit und Einzelwissen abhängt.
    </p>
  </section>
  <section class="section section-mist">
    <div class="site-container about-layout">
      <div>
        <p class="eyebrow">Andreas Böhrnsen · Berlin</p><h2>
          Die Verbesserung muss<br />im Betrieb ankommen.
        </h2>
        <p>
          Ein Konzept allein macht eine gewachsene IT-Landschaft nicht
          verlässlicher. Entscheidend ist, ob Ihr Team den aktuellen Stand
          versteht, Änderungen kontrolliert umsetzt und Systeme wiederherstellen
          kann.
        </p>
        <p>
          Ich verbinde Konfigurationsmanagement mit praktischer Umsetzung:
          Versionierung, Infrastructure as Code, CI/CD und Automatisierung.
          Nicht als Selbstzweck, sondern als Mittel gegen wiederkehrende Fehler
          und unnötige Handarbeit.
        </p>
        <p>
          Sie sprechen direkt mit mir über Ihre Ausgangslage, den sinnvollen
          Umfang und die nächsten Schritte. Die Zusammenarbeit soll Ihr Team
          eigenständiger machen, nicht abhängiger von externer Unterstützung.
        </p>
        <a
          class="text-link"
          href="https://www.linkedin.com/in/andreasboehrnsen/"
          >Mein Profil auf LinkedIn <Icon name="tabler:arrow-up-right" /></a
        >
      </div>
      <div>
        <Image
          src="~/assets/images/service-coaching.jpg"
          alt="Menschen arbeiten gemeinsam mit Unterlagen und einem Laptop an einem Tisch"
          width={700}
          height={620}
          class="about-image"
        /><p class="about-image-caption">
          Symbolbild für die gemeinsame Arbeit im Team.
        </p>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="site-container">
      <div class="section-heading">
        <p class="eyebrow">Worauf Sie sich verlassen können</p><h2>
          Klarer Umfang. Offene Entscheidungen.
        </h2>
      </div>
      <div class="principle-grid">
        <article>
          <h3>Ihre Umgebung zählt.</h3><p>
            Wir prüfen zuerst vorhandene Systeme und Abläufe. Ein bestimmtes
            Tool oder eine neue Plattform ist keine Voraussetzung für die
            Zusammenarbeit.
          </p>
        </article>
        <article>
          <h3>Änderungen bleiben kontrolliert.</h3><p>
            Wir stimmen Eingriffe, Testmöglichkeiten und Rückfallwege mit Ihnen
            ab. Ihr laufender Betrieb setzt den Rahmen für die Umsetzung.
          </p>
        </article>
        <article>
          <h3>Das Wissen bleibt bei Ihnen.</h3><p>
            Dokumentation, gemeinsame Umsetzung und Coaching gehören dazu. Ihr
            Team soll die entstandenen Abläufe verstehen und selbst weiterführen
            können.
          </p>
        </article>
      </div>
    </div>
  </section>
  <section class="section section-mist">
    <div class="site-container results-layout">
      <div>
        <p class="eyebrow">Die technische Grundlage</p><h2>
          Prozesse verstehen.<br />Technisch umsetzen.
        </h2>
      </div>
      <div>
        <p class="section-intro">
          Git und GitLab machen Änderungen sichtbar. Ansible und Terraform
          unterstützen wiederholbare Konfiguration und Infrastrukturaufbau.
          CI/CD verbindet Prüfungen mit der Auslieferung.
        </p><p class="section-intro" style="margin-top:20px">
          Welche Bausteine sinnvoll sind, entscheidet Ihr Problem. Der Maßstab
          ist nicht die Zahl der eingesetzten Werkzeuge, sondern ein
          nachvollziehbarer Systemstand und ein praktikabler Ablauf.
        </p><a class="text-link" href="/#leistungen" style="margin-top:24px"
          >Unsere Leistungen im Überblick <Icon
            name="tabler:arrow-up-right"
          /></a>
      </div>
    </div>
  </section>
  <ConsultationCta placement="about-closing" />
</Layout>
