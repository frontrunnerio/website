---
import Layout from "~/layouts/PageLayout.astro";
import { Icon } from "astro-icon/components";
---

<Layout
  metadata={{
    title: "Seite nicht gefunden",
    robots: { index: false, follow: true },
  }}
>
  <section class="site-container subpage-hero" style="min-height:55vh">
    <p class="eyebrow">Fehler 404</p><h1>
      Hier geht es nicht weiter.<br />Aber zu verlässlicher IT schon.
    </h1><p class="lead">
      Die gesuchte Seite ist nicht verfügbar. Auf unserer Startseite finden Sie
      Leistungen, Vorgehen und den direkten Kontakt.
    </p><a class="action action-dark" href="/" style="margin-top:30px"
      >Zur Startseite <Icon name="tabler:arrow-right" /></a
    >
  </section>
</Layout>
