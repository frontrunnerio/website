  },
];

const combineNote = {
  title: "Alles greift ineinander:",
  description:
    "Der Check zeigt, wo Sie starten. Infrastruktur als Code und Container sind das Fundament. Darauf werden Umzüge sicher — und Testumgebungen machen jede weitere Änderung risikoarm.",
};

const process = {
  tagline: "Ablauf",
  title: "So läuft jede Leistung ab",
  subtitle:
    "Unabhängig davon, welche Leistung Sie wählen: Wir arbeiten immer in denselben drei Schritten. So bleibt das Risiko klein und das Ergebnis planbar.",
  callToAction: bookCta,
  items: [
    {
      title: "Erstgespräch",
      description:
        "30 Minuten, kostenlos. Wir klären, was ansteht und ob wir helfen können.",
      icon: "tabler:phone-call",
    },
    {
      title: "Konkreter Plan",
      description:
        "Schriftlicher Vorschlag mit Umfang, Aufwand, Nutzen und Rückfallplan.",
      icon: "tabler:list-check",
    },
    {
      title: "Pilot-Umsetzung",
      description:
        "Ein klar abgegrenztes System wird umgesetzt. Sie sehen das Ergebnis, bevor Sie über mehr entscheiden.",
      icon: "tabler:rocket",
    },
  ],
};

const faqs = {
  tagline: "FAQs",
  title: "Fragen zu den Leistungen",
  items: [
    {
      title: "In welcher Reihenfolge sollten wir anfangen?",
      description:
        "Wenn Sie unsicher sind: mit dem Software-Delivery-Check. Wenn Sie ein konkretes Ziel haben — etwa Lizenzkosten senken — sprechen wir im Erstgespräch direkt über genau diesen Umzug und prüfen, welches Fundament dafür nötig ist.",
    },
    {
      title: "Wie berechnen Sie die Leistungen?",
      description:
        "Check und Piloten haben einen festen Umfang und einen Festpreis, den Sie vor Beginn kennen. Für den weiteren Rollout vereinbaren wir je nach Bedarf Festpreise pro System oder ein Kontingent.",
    },
    {
      title: "Müssen wir unsere Werkzeuge wechseln?",
      description:
        "Nein. Wir arbeiten mit dem, was Sie haben — GitLab, GitHub, Azure DevOps, Proxmox, VMware, Cloud oder eigenes Rechenzentrum. Wir empfehlen einen Wechsel nur, wenn er sich klar rechnet.",
    },
    {
      title: "Was ist mit unserem bestehenden IT-Dienstleister?",
      description:
        "Wir arbeiten gern mit ihm zusammen. Unser Ziel ist, dass Ihr Unternehmen die Änderung versteht und besitzt — egal, wer sie später betreibt.",
    },
  ],
};

const cta = {
  title: "Welche Leistung passt zu Ihrer Situation?",
  subtitle:
    "Im kostenlosen Erstgespräch finden wir es in 30 Minuten heraus — ohne Verpflichtung.",
  actions: [{ variant: "primary" as const, ...bookCta }],
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline={hero.tagline}
    title={hero.title}
    subtitle={hero.subtitle}
    callToAction={bookCta}
    callToAction2={{ text: "Leistungen im Detail", href: "#cicd-assessment" }}
  />

  <Features2
    tagline={overview.tagline}
    title={overview.title}
    subtitle={overview.subtitle}
    columns={3}
    items={overview.items}
  >
    <Fragment slot="bg"
      ><div class="absolute inset-0 bg-blue-50 dark:bg-transparent">
      </div></Fragment
    >
  </Features2>

  {
    services.map((s, index) => (
      <Content
        id={s.id}
        tagline={s.groupTagline}
        title={s.groupTitle}
        subtitle={s.groupSubtitle}
        isReversed={index % 2 === 0}
        isAfterContent={!s.groupTitle}
        items={s.benefits}
        image={s.image}
        callToAction={{
          text: "Dazu beraten lassen",
          href: BOOKING_URL,
          icon: "tabler:calendar",
        }}
      >
        <Fragment slot="content">
          <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
            {s.title}
          </h3>
          <p class="mb-4">{s.caption}</p>
          <p class="text-muted dark:text-slate-400 text-base mb-4">
            {s.forWhom}
          </p>
          <p class="text-base font-medium">{s.result}</p>
        </Fragment>
      </Content>
    ))
  }

  <Note title={combineNote.title} description={combineNote.description} />

  <Steps2
    tagline={process.tagline}
    title={process.title}
    subtitle={process.subtitle}
    items={process.items}
    callToAction={process.callToAction}
  >
    <Fragment slot="bg"
      ><div class="absolute inset-0 bg-blue-50 dark:bg-transparent">
      </div></Fragment
    >
  </Steps2>

  <FAQs
    tagline={faqs.tagline}
    title={faqs.title}
    classes={{ container: "max-w-6xl" }}
    items={faqs.items}
  />

  <CallToAction actions={cta.actions}>
    <Fragment slot="title">{cta.title}</Fragment>
    <Fragment slot="subtitle">{cta.subtitle}</Fragment>
  </CallToAction>
</Layout>
