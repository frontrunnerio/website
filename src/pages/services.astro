---
import Layout from "~/layouts/PageLayout.astro";
import HeroText from "~/components/widgets/HeroText.astro";
import Features2 from "~/components/widgets/Features2.astro";
import Content from "~/components/widgets/Content.astro";
import Note from "~/components/widgets/Note.astro";
import Steps2 from "~/components/widgets/Steps2.astro";
import FAQs from "~/components/widgets/FAQs.astro";
import CallToAction from "~/components/widgets/CallToAction.astro";

import { BOOKING_URL } from "~/data/site";

const metadata = {
  title: "Leistungen — IT-Kosten senken, Systeme ablösen, Änderungen absichern",
  ignoreTitleTemplate: true,
  description:
    "Sieben Leistungen für den Mittelstand: Software-Delivery-Check, Infrastruktur als Code, Container, Testumgebungen, Ablösung von Windows-, Oracle- und MSSQL-Lizenzen, Cloud-Umzug in die EU.",
};

const bookCta = {
  text: "Erstgespräch buchen",
  href: BOOKING_URL,
  icon: "tabler:calendar",
};

const hero = {
  tagline: "Leistungen",
  title: "Sieben Wege, Ihre IT verlässlicher und günstiger zu machen",
  subtitle:
    "Jede Leistung löst ein Problem, das Sie wahrscheinlich kennen: zu teuer, zu riskant, zu abhängig. Jede hat ein klares Ergebnis, ist einzeln buchbar und lässt sich als Pilot in wenigen Wochen umsetzen.",
};

const overview = {
  tagline: "Übersicht",
  title: "Drei Ziele, sieben Leistungen",
  subtitle:
    "Wir sortieren unsere Leistungen nach dem, was sie für Sie bewirken: Klarheit schaffen, Änderungen absichern, Kosten senken.",
  items: [
    {
      title: "1 · Klarheit schaffen",
      description:
        "<strong>Software-Delivery-Check</strong> — Wir zeigen, wo Ihre Software-Auslieferung Zeit verliert, wo Risiken liegen und was zuerst zu tun ist.",
      icon: "tabler:search",
      callToAction: {
        variant: "link" as const,
        text: "Zum Check",
        href: "#cicd-assessment",
      },
    },
    {
      title: "2 · Änderungen absichern",
      description:
        "<strong>Infrastruktur als Code</strong>, <strong>Anwendungen containerisieren</strong> und <strong>Testumgebung pro Änderung</strong> — damit jede Änderung wiederholbar, testbar und rückgängig zu machen ist.",
      icon: "tabler:shield-check",
      callToAction: {
        variant: "link" as const,
        text: "Zu den Leistungen",
        href: "#infrastructure-as-code",
      },
    },
    {
      title: "3 · Kosten senken",
      description:
        "<strong>Server-Lizenzen ablösen</strong>, <strong>Datenbank-Lizenzen ablösen</strong> und <strong>Cloud-Umzug in die EU</strong> — Umzüge, die jedes Jahr Lizenz- und Hardwarekosten sparen. Sicher umgesetzt, weil das Fundament steht.",
      icon: "tabler:coin-euro",
      callToAction: {
        variant: "link" as const,
        text: "Zu den Migrationen",
        href: "#windows-to-linux",
      },
    },
  ],
};

const services = [
  {
    id: "cicd-assessment",
    groupTagline: "Klarheit schaffen",
    groupTitle: "Wissen, wo Sie stehen",
    groupSubtitle:
      "Bevor etwas geändert wird, muss klar sein, was sich lohnt. Der Check liefert diesen Befund in wenigen Tagen.",
    title: "Software-Delivery-Check",
    caption:
      "Wir prüfen, wie schnell und wie sicher Ihre Software von der Änderung bis in den Betrieb kommt — ehrlich bewertet, klar priorisiert. Der Befund, auf dem alles Weitere aufbaut.",
    image: {
      src: "~/assets/images/service-assessment.jpg",
      alt: "Software-Delivery-Check",
    },
    forWhom:
      "Für Unternehmen, die eigene Software entwickeln und bei denen Releases lange dauern, oft fehlschlagen oder niemand genau weiß, wie sicher der Weg von Code zu Produktion ist.",
    benefits: [
      {
        title: "Sie wissen, wo Zeit und Geld verloren gehen",
        description:
          "Wir messen Build-Zeiten, Fehlerraten und Wartezeiten und zeigen, welche Engpässe Ihr Team wirklich bremsen.",
      },
      {
        title:
          "Sicherheitslücken werden sichtbar, bevor jemand anderes sie findet",
        description:
          "Umgang mit Zugangsdaten, Abhängigkeiten, Berechtigungen und Nachvollziehbarkeit — geprüft gegen gängige Standards.",
      },
      {
        title: "Eine priorisierte Liste statt eines dicken Berichts",
        description:
          "Was zuerst? Was bringt am meisten für den geringsten Aufwand? Sie erhalten eine Reihenfolge, mit der Sie sofort starten können.",
      },
      {
        title: "Eine Entscheidungsgrundlage für Geschäftsführung und IT",
        description:
          "Verständlich formuliert, mit Aufwandsschätzung und erwartetem Nutzen — damit die Freigabe für den nächsten Schritt leicht fällt.",
      },
    ],
    result:
      "Ergebnis: Schriftlicher Befund mit priorisierten Maßnahmen.",
  },
  {
    id: "infrastructure-as-code",
    groupTagline: "Änderungen absichern",
    groupTitle: "Das Fundament für verlässliche Änderungen",
    groupSubtitle:
      "Drei Bausteine, die dafür sorgen, dass jede Änderung reproduzierbar, testbar und im Zweifel rückgängig zu machen ist.",
    title: "Infrastruktur als Code",
    caption:
      "Server, Netzwerk und Einstellungen als Code: dokumentiert, geprüft, in Minuten neu aufbaubar. Das Wissen steckt im System — nicht mehr nur bei einem Kollegen.",
    image: {
      src: "~/assets/images/service-consolidation.jpg",
      alt: "Infrastructure as Code",
    },
    forWhom:
      "Für Unternehmen, deren Server von Hand eingerichtet wurden, deren Konfiguration nur in Köpfen existiert und die keine zweite Umgebung zum Testen haben.",
    benefits: [
      {
        title: "Kein Server ist mehr ein Unikat",
        description:
          "Jede Umgebung lässt sich aus dem Code neu aufbauen — identisch, in Minuten statt Tagen. Das gilt für Test, Staging und Produktion.",
      },
      {
        title: "Jede Änderung ist dokumentiert und nachvollziehbar",
        description:
          "Wer hat wann was geändert, und warum? Die Antwort steht in der Versionsgeschichte, nicht in einer E-Mail von vor drei Jahren.",
      },
      {
        title: "Änderungen werden geprüft, bevor sie angewendet werden",
        description:
          "Ein Review-Prozess wie für Anwendungscode: Vier Augen, automatische Prüfung, dann erst Umsetzung.",
      },
      {
        title: "Wissen bleibt im Unternehmen",
        description:
          "Wenn ein Kollege oder ein Dienstleister geht, bleibt die Infrastruktur verständlich und bedienbar.",
      },
    ],
    result:
      "Ergebnis: Ein Pilot-System vollständig als Code, inklusive Einführung Ihres Teams in den Arbeitsablauf.",
  },
  {
    id: "containerization",
    title: "Anwendungen containerisieren",
    caption:
      "Ihre Anwendung läuft auf dem Laptop, im Test und in Produktion exakt gleich — weil sie ihre gesamte Umgebung mitbringt.",
    image: {
      src: "~/assets/images/service-containers.jpg",
      alt: "Anwendungen containerisieren",
    },
    forWhom:
      "Für Unternehmen, bei denen „auf meinem Rechner läuft es“ ein bekannter Satz ist und Deployments von der Konfiguration des jeweiligen Servers abhängen.",
    benefits: [
      {
        title: "Schluss mit „bei mir läuft es aber“",
        description:
          "Die Anwendung bringt ihre gesamte Laufzeitumgebung mit. Unterschiede zwischen Entwicklung, Test und Produktion verschwinden.",
      },
      {
        title: "Deployments in Minuten, Rollbacks in Sekunden",
        description:
          "Eine neue Version starten oder zur alten zurückkehren wird zum Routinevorgang statt zum Wochenendprojekt.",
      },
      {
        title: "Unabhängig von einzelnen Servern und Betriebssystemen",
        description:
          "Containerisierte Anwendungen laufen auf jedem Linux-Host, in der Cloud oder im eigenen Rechenzentrum — die Grundlage für spätere Migrationen.",
      },
      {
        title: "Voraussetzung für Review Apps und moderne CI/CD",
        description:
          "Wer containerisiert hat, kann jede Änderung automatisch in einer eigenen Umgebung testen. Der nächste Schritt wird einfach.",
