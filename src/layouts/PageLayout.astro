---
import Layout from "~/layouts/Layout.astro";
import Header from "~/components/widgets/Header.astro";
import Footer from "~/components/widgets/Footer.astro";

import { getHeaderData, getFooterData } from "~/navigation";
import { getLang } from "~/i18n/utils";

import type { MetaData } from "~/types";

export interface Props {
  metadata?: MetaData;
}

const { metadata } = Astro.props;
const lang = getLang(Astro);
const headerData = getHeaderData(lang);
const footerData = getFooterData(lang);
---

<Layout metadata={metadata}>
  <!--
  <slot name="announcement">
    <Announcement />
  </slot>
 -->
  <slot name="header">
    <Header {...headerData} isSticky showToggleTheme position="right" />
  </slot>
  <a
    href="#main-content"
    class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-page focus:p-4"
    >{lang === "en" ? "Skip to content" : "Zum Inhalt"}</a
  >
  <main id="main-content" tabindex="-1" class="[overflow-wrap:anywhere]">
    <slot />
  </main>
  <slot name="footer">
    <Footer {...footerData} />
  </slot>
</Layout>
